{
  "name": "@event-manager/public-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --conditions=@event-manager/source --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.21.0",
    "@event-manager/db": "workspace:*",
    "@event-manager/schemas": "workspace:*",
    "@fastify/swagger": "^9.9.3",
    "@fastify/type-provider-typebox": "^6.3.0",
    "fastify": "^5.12.8"
  }
}
