{
  "name": "@event-manager/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --conditions=@event-manager/source --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "openapi": "tsx --conditions=@event-manager/source src/cli/emit-openapi.ts ../../packages/sdk/openapi/core.json",
    "create-account": "tsx --conditions=@event-manager/source --env-file-if-exists=../../.env src/cli/create-account.ts"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.21.0",
    "@event-manager/db": "workspace:*",
    "@event-manager/domain": "workspace:*",
    "@event-manager/schemas": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/type-provider-typebox": "^6.3.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.17",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "kysely": "^0.29.9"
  }
}
