# Migrator connection (owns schemas). Locally the docker-compose superuser.
MIGRATOR_DATABASE_URL=postgres://postgres:postgres@localhost:5432/event_manager
# Runtime connection: a login role that is a member of em_app (cannot bypass RLS).
DATABASE_URL=postgres://app_user:app_user@localhost:5432/event_manager

# Staff auth. In Azure: Entra External ID. Locally you can set these too, to sign in with
# real Entra tokens (infra/README.md, "Local sign-in with Entra External ID").
#   OIDC_ISSUER=https://<external-tenant-id>.ciamlogin.com/<external-tenant-id>/v2.0
#   OIDC_AUDIENCE=<em-api client ID (GUID)>
OIDC_ISSUER=
OIDC_AUDIENCE=
# Local only: accept HS256 dev tokens signed with this secret. Refused when NODE_ENV=production.
AUTH_DEV_SECRET=local-dev-secret-change-me

# Admin (Vite). VITE_AUTH_MODE=dev signs local tokens; msal signs in through Entra and
# needs the three VITE_ENTRA_* values:
#   VITE_ENTRA_CLIENT_ID=<em-admin client ID>
#   VITE_ENTRA_AUTHORITY=https://<prefix>.ciamlogin.com/
#   VITE_ENTRA_API_SCOPE=api://em-api-staging/access
VITE_API_BASE_URL=http://localhost:3000
VITE_AUTH_MODE=dev
VITE_AUTH_DEV_SECRET=local-dev-secret-change-me
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=
VITE_ENTRA_API_SCOPE=
